        window.addEventListener("resize", () => this.handleResize());
      },

      loadSavedProgress() {
        try {
          const savedName = localStorage.getItem("ninja_fraction_player");
          if (savedName) {
            document.getElementById("player-name-input").value = savedName;
          }
          const savedRanks = JSON.parse(localStorage.getItem("ninja_fraction_ranks") || "{}");
          for (let lv = 1; lv <= 4; lv++) {
            const badge = document.getElementById(`badge-level-${lv}`);
            if (badge && savedRanks[lv]) {
              badge.textContent = `⭐ ${savedRanks[lv]}`;
              badge.className = "text-xs font-extrabold text-emerald-800 bg-emerald-100 px-2 py-1 rounded-lg";
            }
          }
        } catch (e) {}
      },

      saveLevelRank(level, rankName) {
        try {
          const savedRanks = JSON.parse(localStorage.getItem("ninja_fraction_ranks") || "{}");
          savedRanks[level] = rankName;
          localStorage.setItem("ninja_fraction_ranks", JSON.stringify(savedRanks));
          this.loadSavedProgress();
        } catch (e) {}
      },

      selectLevel(lv) {
        this.selectedLevel = lv;
        document.querySelectorAll(".level-card").forEach(btn => {
          const btnLv = Number(btn.getAttribute("data-level-btn"));
          if (btnLv === lv) {
            btn.classList.add("border-red-600", "ring-2", "ring-red-400", "bg-white");
            btn.classList.remove("border-amber-300", "bg-white/90");
          } else {
            btn.classList.remove("border-red-600", "ring-2", "ring-red-400", "bg-white");
            btn.classList.add("border-amber-300", "bg-white/90");
          }
        });
      },

      handleResize() {
        if (!this.canvas) return;
        const wrapper = document.getElementById("canvas-wrapper");
        const rect = wrapper.getBoundingClientRect();
        if (rect.width <= 0 || rect.height <= 0) return;

        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        this.canvas.width = Math.floor(rect.width * dpr);
        this.canvas.height = Math.floor(rect.height * dpr);

        const aspect = rect.width / rect.height;
        this.logicalHeight = 500;
        this.logicalWidth = Math.max(480, Math.round(this.logicalHeight * aspect));
        this.ctx.setTransform(this.canvas.width / this.logicalWidth, 0, 0, this.canvas.height / this.logicalHeight, 0, 0);
      },

      bindInputs() {
        // Kontrol Keyboard Desktop (mencegah repeat pada tombol lompat & jeda)
        window.addEventListener("keydown", (e) => {
          if (e.target && ["INPUT", "TEXTAREA", "SELECT"].includes(e.target.tagName)) return;

          if (e.code === "ArrowLeft" || e.code === "KeyA") {
            this.keys.left = true;
          }
          if (e.code === "ArrowRight" || e.code === "KeyD") {
            this.keys.right = true;
          }
          if (e.code === "Space" || e.code === "ArrowUp" || e.code === "KeyW") {
            if (this.state === "PLAYING") e.preventDefault();
            if (!e.repeat && this.state === "PLAYING") {
              this.triggerJump();
            }
          }
          if (e.code === "Escape" && !e.repeat) {
            if (this.state === "PLAYING") {
              this.pauseGame();
            } else if (this.state === "PAUSED") {
              this.resumeGame();
            }
          }
        });

        window.addEventListener("keyup", (e) => {
          if (e.code === "ArrowLeft" || e.code === "KeyA") this.keys.left = false;
          if (e.code === "ArrowRight" || e.code === "KeyD") this.keys.right = false;
        });

        // Kontrol Sentuh Ponsel / Tablet
        const bindHold = (elId, keyName) => {
          const el = document.getElementById(elId);
          if (!el) return;
          const start = (e) => {
            e.preventDefault();
            this.keys[keyName] = true;
          };
          const end = (e) => {
            e.preventDefault();
            this.keys[keyName] = false;
          };
          el.addEventListener("touchstart", start, { passive: false });
          el.addEventListener("touchend", end, { passive: false });
          el.addEventListener("touchcancel", end, { passive: false });
          el.addEventListener("mousedown", start);
          el.addEventListener("mouseup", end);
          el.addEventListener("mouseleave", end);
        };

        bindHold("touch-left", "left");
        bindHold("touch-right", "right");

        const jumpBtn = document.getElementById("touch-jump");
        if (jumpBtn) {
          const doJump = (e) => {
            e.preventDefault();
            if (this.state === "PLAYING") this.triggerJump();
          };
          jumpBtn.addEventListener("touchstart", doJump, { passive: false });
          jumpBtn.addEventListener("mousedown", doJump);
        }
      },

      toggleAutoRun() {
        this.autoRun = !this.autoRun;
        const btn = document.getElementById("hud-autorun-btn");
        btn.textContent = this.autoRun ? "🏃 Auto-Lari: ON" : "🧍 Auto-Lari: OFF";
        btn.className = this.autoRun
          ? "px-2.5 py-1.5 rounded-xl bg-emerald-700/80 hover:bg-emerald-600 text-white text-xs font-bold border border-emerald-400/50"
          : "px-2.5 py-1.5 rounded-xl bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs font-bold border border-slate-500";
      },

      /**
       * Memulai permainan pada level tertentu
       */
      startLevel(level) {
        AudioFX.init();
        this.currentLevel = level;
        this.selectedLevel = level;

        const nameVal = document.getElementById("player-name-input").value.trim() || "Ninja Muda";
        this.playerName = nameVal;
        try {
          localStorage.setItem("ninja_fraction_player", nameVal);
        } catch (e) {}

        // Reset statistik
        this.score = 0;
        this.coins = 0;
        this.lives = this.maxLives;
        this.correctCount = 0;
        this.wrongCount = 0;
        this.mistakeTypes = [];
        this.elapsedSeconds = 0;
        this.levelStartTime = performance.now();
        this.activeObstacleIndex = -1;
        this.currentQuestion = null;

        QuestionEngine.resetSession();
        AISensei.prefetchAIProblems(level);

        // Bangun dunia level
        this.buildWorld(level);

        // Tampilkan layar game & perbarui HUD
        UI.showScreen("screen-game");
        UI.closeModal("modal-explanation");
        UI.closeModal("modal-pause");
        document.getElementById("question-overlay").classList.add("hidden");

        this.handleResize();
        this.updateHUD();
        this.state = "PLAYING";

        if (this.rafId) cancelAnimationFrame(this.rafId);
        this.lastFrameTime = performance.now();
        this.rafId = requestAnimationFrame((ts) => this.gameLoop(ts));
      },

      startNextLevel() {
        const nextLv = Math.min(4, this.currentLevel + 1);
        this.startLevel(nextLv);
      },

      buildWorld(level) {
        this.groundY = 395;
        this.cameraX = 0;
        this.ninja = {
          x: 110,
          y: this.groundY,
          w: 44,
          h: 54,
          vx: 0,
          vy: 0,
          grounded: true,
          facing: 1,
          runCycle: 0,
          flipAngle: 0,
          isHeroJumping: false,
          hurtTimer: 0
        };

        // 5 Rintangan Matematika per Level
        const obstacleTypes = [
          { type: "chasm", name: "Jurang Bambu Runcing" },
          { type: "boulder", name: "Batu Segel Raksasa" },
          { type: "river", name: "Jembatan Sungai Koi" },
          { type: "gate", name: "Gerbang Gulungan Naga" },
          { type: "chasm", name: "Jurang Kuil Master" }
        ];

        this.obstacles = [];
        this.platforms = [];
        this.coinItems = [];
        this.particles = [];

        const spacing = 680;
        for (let i = 0; i < 5; i++) {
          const obsX = 660 + i * spacing;
          const info = obstacleTypes[i];
          this.obstacles.push({
            index: i,
            x: obsX,
            width: 115,
            triggerX: obsX - 58,
            type: info.type,
            name: info.name,
            solved: false
          });

          // Platform bambu melayang sebelum rintangan untuk melompat & mengambil koin
          const platX = obsX - 360;
          const platY = 290 - (i % 2) * 28;
          this.platforms.push({
            x: platX,
            y: platY,
            w: 145,
            h: 18
          });

          // Koin di atas platform bambu
          for (let c = 0; c < 3; c++) {
            this.coinItems.push({
              x: platX + 28 + c * 44,
              y: platY - 28,
              r: 13,
              collected: false,
              bobOffset: c * 0.8
            });
          }

          // Koin melengkung di atas rintangan (didapat saat melompati rintangan!)
          for (let c = 0; c < 3; c++) {
            this.coinItems.push({
              x: obsX + 18 + c * 40,
              y: this.groundY - 125 - (c === 1 ? 26 : 0),
              r: 13,
              collected: false,
              bobOffset: c * 0.6
            });
          }
        }

        this.finishX = 660 + 4 * spacing + 340;
        this.worldLength = this.finishX + 350;

        // Awan & Kelopak Bunga Sakura Latar Belakang
        this.clouds = Array.from({ length: 10 }, (_, idx) => ({
          x: idx * 450 + Math.random() * 180,
          y: 45 + (idx % 3) * 38,
          scale: 0.7 + (idx % 3) * 0.25,
          speed: 14 + (idx % 3) * 6
        }));

        this.sakuraPetals = Array.from({ length: 28 }, () => ({
          x: Math.random() * this.logicalWidth,
          y: Math.random() * this.logicalHeight,
          vx: -25 - Math.random() * 25,
          vy: 22 + Math.random() * 25,
          size: 4 + Math.random() * 4,
          rot: Math.random() * Math.PI * 2
        }));
      },

      triggerJump() {
        if (this.ninja.grounded) {
          this.ninja.vy = -650;
          this.ninja.grounded = false;
          AudioFX.playJump();
          this.spawnParticles(this.ninja.x + 22, this.ninja.y, "#fde68a", 8);
        }
      },

      /**
       * Loop Animasi Utama berbasis Delta Time
       */
      gameLoop(timestamp) {
        const rawDt = (timestamp - this.lastFrameTime) / 1000;
        this.lastFrameTime = timestamp;
        const dt = Math.min(rawDt, 0.05); // Batasi delta time agar fisika stabil

        if (this.state === "PLAYING") {
          this.elapsedSeconds += dt;
          this.updatePhysics(dt);
        } else if (this.state === "QUESTION" || this.state === "EXPLANATION") {
          // Tetap jalankan partikel & timer bonus saat modal terbuka
          this.updateAmbient(dt);
          if (this.state === "QUESTION") {
            this.updateQuestionTimer();
          }
        }

        this.render();
        this.rafId = requestAnimationFrame((ts) => this.gameLoop(ts));
      },

      updateAmbient(dt) {
        // Gerakkan awan & kelopak sakura
        this.clouds.forEach(c => {
          c.x -= c.speed * dt;
          if (c.x < -160) c.x = this.worldLength + 100;
        });

        this.sakuraPetals.forEach(p => {
          p.x += p.vx * dt;
          p.y += p.vy * dt;
          p.rot += 2.2 * dt;
          if (p.y > this.logicalHeight) {
            p.y = -10;
            p.x = Math.random() * this.logicalWidth;
          }
          if (p.x < -10) p.x = this.logicalWidth + 10;
        });

        // Update partikel
        for (let i = this.particles.length - 1; i >= 0; i--) {
          const pt = this.particles[i];
          pt.x += pt.vx * dt;
          pt.y += pt.vy * dt;
          pt.vy += 450 * dt;
          pt.life -= dt;
          if (pt.life <= 0) this.particles.splice(i, 1);
        }
      },

      updatePhysics(dt) {
        this.updateAmbient(dt);

        const n = this.ninja;
        if (n.hurtTimer > 0) n.hurtTimer = Math.max(0, n.hurtTimer - dt);

        // Kecepatan Horizontal Ninja
        const baseSpeed = 235;
        if (n.isHeroJumping) {
          n.vx = 360;
          n.facing = 1;
          n.flipAngle += 11 * dt;
        } else {
          let moveDir = 0;
          if (this.keys.left) moveDir -= 1;
          if (this.keys.right) moveDir += 1;

          if (moveDir !== 0) {
            n.vx = moveDir * (baseSpeed + 45);
            n.facing = moveDir;
          } else if (this.autoRun) {
            n.vx = baseSpeed;
            n.facing = 1;
          } else {
            n.vx = 0;
          }
        }

        const prevY = n.y;
        n.x += n.vx * dt;
        n.x = Math.max(40, Math.min(this.finishX + 40, n.x));

        // Gravitasi & Pergerakan Vertikal
        n.vy += this.gravity * dt;
        n.y += n.vy * dt;

        // Cek pendaratan pada platform bambu melayang (hanya saat jatuh dari atas)
        let landedOnPlatform = false;
        if (n.vy >= 0 && !n.isHeroJumping) {
          for (const plat of this.platforms) {
            const withinX = n.x + n.w * 0.7 > plat.x && n.x + n.w * 0.3 < plat.x + plat.w;
            if (withinX && prevY <= plat.y + 6 && n.y >= plat.y) {
              n.y = plat.y;
              n.vy = 0;
              n.grounded = true;
              landedOnPlatform = true;
              break;
            }
          }
        }

        // Pendaratan pada tanah utama
        if (!landedOnPlatform) {
          if (n.y >= this.groundY) {
            n.y = this.groundY;
            n.vy = 0;
            n.grounded = true;
            if (n.isHeroJumping) {
              n.isHeroJumping = false;
              n.flipAngle = 0;
              this.spawnParticles(n.x + 22, n.y, "#fde047", 14);
            }
          } else {
            n.grounded = false;
          }
        }

        if (n.grounded && Math.abs(n.vx) > 5) {
          n.runCycle += 14 * dt;
        }

        // Cek Pengumpulan Koin Emas
        for (const coin of this.coinItems) {
          if (coin.collected) continue;
          const dx = (n.x + n.w / 2) - coin.x;
          const dy = (n.y - n.h / 2) - coin.y;
          if (Math.hypot(dx, dy) < 38) {
            coin.collected = true;
            this.coins += 1;
            this.score += 2;
            AudioFX.playCoin();
            this.spawnParticles(coin.x, coin.y, "#fbbf24", 10);
            this.updateHUD();
          }
        }

        // Cek Pendekatan ke Rintangan Berikutnya
        if (!n.isHeroJumping) {
          for (const obs of this.obstacles) {
            if (!obs.solved && n.x + n.w >= obs.triggerX) {
              n.x = obs.triggerX - n.w;
              n.vx = 0;
              n.y = this.groundY;
              n.vy = 0;
              n.grounded = true;
              this.triggerObstacleQuestion(obs.index);
              return;
            }
          }
        }

        // Cek Mencapai Garis Finis
        if (n.x >= this.finishX) {
          this.finishLevel(true);
          return;
        }

        // Kamera Mengikuti Ninja dengan Halus
        const targetCamX = Math.max(0, Math.min(this.worldLength - this.logicalWidth, n.x - this.logicalWidth * 0.28));
        this.cameraX += (targetCamX - this.cameraX) * Math.min(1, 8 * dt);
      },

      spawnParticles(x, y, color, count = 12) {
        for (let i = 0; i < count; i++) {
          const angle = (Math.PI * 2 * i) / count + Math.random() * 0.4;
          const speed = 90 + Math.random() * 190;
          this.particles.push({
            x,
            y,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed - 90,
            color,
            size: 4 + Math.random() * 4,
            life: 0.45 + Math.random() * 0.35
          });
        }
      },

      /**
       * ======================================================================
       * INTEGRASI SOAL MATEMATIKA SAAT MENDEKATI RINTANGAN
       * ======================================================================
       */
      triggerObstacleQuestion(obsIndex) {
        this.state = "QUESTION";
        this.activeObstacleIndex = obsIndex;
        this.attemptsOnCurrentObstacle = 0;
        this.hintLevelShown = 0;
        this.questionStartTime = performance.now();

        const obs = this.obstacles[obsIndex];
        const q = AISensei.getNextProblem(this.currentLevel);
        this.currentQuestion = q;

        // Isi elemen UI Gulungan Soal
        document.getElementById("q-obstacle-label").textContent = `🚧 Rintangan ${obsIndex + 1}/5: ${obs.name}`;
        document.getElementById("q-source-tag").textContent = `📜 ${q.source}`;

        const storyBox = document.getElementById("q-story-box");
        if (q.story) {
          storyBox.textContent = q.story;
          storyBox.classList.remove("hidden");
        } else {
          storyBox.classList.add("hidden");
        }

        // Render ekspresi matematika pecahan bertumpuk
        const exprEl = document.getElementById("q-math-expression");
        const partsHTML = q.operands.map(op => op.frac.toHTML(this.currentLevel >= 3));
        exprEl.innerHTML = `${partsHTML.join(` <span class="text-red-600 mx-1">+</span> `)} <span class="text-slate-500 mx-1">=</span> <span class="px-3 py-1 rounded-xl bg-amber-100 border-2 border-dashed border-amber-500 text-amber-800">?</span>`;

        // Reset kotak umpan balik & petunjuk
        document.getElementById("q-feedback-banner").classList.add("hidden");
        document.getElementById("q-hint-box").classList.add("hidden");
        const hintBtn = document.getElementById("btn-request-hint");
        hintBtn.disabled = false;
        hintBtn.innerHTML = `<span>💡</span><span>Minta Petunjuk (1/2)</span>`;

        // Render 4 tombol pilihan jawaban
        const optionsGrid = document.getElementById("q-options-grid");
        optionsGrid.innerHTML = "";
        const letters = ["A", "B", "C", "D"];

        q.options.forEach((opt, idx) => {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "btn-ninja p-3 sm:p-4 rounded-2xl bg-white hover:bg-amber-50 border-3 border-amber-500 text-slate-900 font-display font-bold text-xl sm:text-2xl flex items-center justify-center gap-3 shadow";
          btn.innerHTML = `
            <span class="w-8 h-8 rounded-full bg-amber-200 text-amber-950 text-sm font-extrabold flex items-center justify-center shrink-0">${letters[idx]}</span>
            <span>${opt.labelHTML}</span>
          `;
          btn.onclick = () => this.submitAnswer(opt, btn);
          optionsGrid.appendChild(btn);
        });

        document.getElementById("question-overlay").classList.remove("hidden");
        this.updateQuestionTimer();
      },

      updateQuestionTimer() {
        const elapsed = (performance.now() - this.questionStartTime) / 1000;
        const remaining = Math.max(0, Math.ceil(this.bonusTimeLimit - elapsed));
        const timerEl = document.getElementById("q-bonus-timer");
        if (remaining > 0) {
          timerEl.textContent = `Bonus +5: ${remaining}d`;
          timerEl.className = "text-xs font-extrabold text-emerald-700";
        } else {
          timerEl.textContent = `Waktu Bonus Habis`;
          timerEl.className = "text-xs font-bold text-slate-500";
        }
      },

      showProgressiveHint() {
        if (!this.currentQuestion) return;
        const hints = this.currentQuestion.hints;
        if (this.hintLevelShown < hints.length) {
          this.hintLevelShown++;
          const box = document.getElementById("q-hint-box");
          const textEl = document.getElementById("q-hint-text");
          textEl.innerHTML = hints.slice(0, this.hintLevelShown).map((h, i) => `<p class="mb-1"><strong>Tahap ${i + 1}:</strong> ${h}</p>`).join("");
          box.classList.remove("hidden");

          const btn = document.getElementById("btn-request-hint");
          if (this.hintLevelShown >= hints.length) {
            btn.disabled = true;
            btn.innerHTML = `<span>💡</span><span>Semua Petunjuk Tampil</span>`;
          } else {
            btn.innerHTML = `<span>💡</span><span>Petunjuk Berikutnya (${this.hintLevelShown + 1}/${hints.length})</span>`;
          }
        }
      },

      /**
       * Memproses pilihan jawaban siswa
       */
      submitAnswer(selectedOption, btnElement) {
        if (this.state !== "QUESTION" || !this.currentQuestion) return;
        const q = this.currentQuestion;
        const elapsedSec = (performance.now() - this.questionStartTime) / 1000;

        if (selectedOption.isCorrect) {
          // JAWABAN BENAR!
          AudioFX.playCorrect();
          this.correctCount += 1;
          this.lastAnswerWasCorrect = true;

          const gotSpeedBonus = elapsedSec <= this.bonusTimeLimit;
          const earnedPoints = gotSpeedBonus ? 15 : 10;
          this.score += earnedPoints;

          document.getElementById("question-overlay").classList.add("hidden");
          this.updateHUD();
          this.openExplanationModal(true, earnedPoints, gotSpeedBonus);
        } else {
          // JAWABAN SALAH
          AudioFX.playWrong();
          this.wrongCount += 1;
          this.attemptsOnCurrentObstacle += 1;
          this.lives = Math.max(0, this.lives - 1);
          this.ninja.hurtTimer = 0.7;

          if (selectedOption.misconception) {
            this.mistakeTypes.push(selectedOption.misconception);
          }

          this.updateHUD();

          // Nonaktifkan tombol pilihan yang salah
          btnElement.disabled = true;
          btnElement.classList.add("bg-rose-100", "border-rose-400", "opacity-60");

          // Efek getaran ringan pada kartu soal
          const card = document.getElementById("question-card");
          card.classList.remove("animate-shake");
          void card.offsetWidth;
          card.classList.add("animate-shake");

          // Jika nyawa habis atau sudah 2 kali salah pada rintangan ini -> tampilkan pembahasan lengkap
          if (this.lives <= 0 || this.attemptsOnCurrentObstacle >= 2) {
            this.lastAnswerWasCorrect = false;
            document.getElementById("question-overlay").classList.add("hidden");
            this.openExplanationModal(false, 0, false);
          } else {
            // Berikan umpan balik ramah & petunjuk bertahap tanpa langsung membocorkan jawaban
            const fbBanner = document.getElementById("q-feedback-banner");
            const fbText = document.getElementById("q-feedback-text");

            let friendlyMsg = "Hampir benar, Ninja Muda! Mari samakan penyebutnya terlebih dahulu.";
            if (selectedOption.misconception === "menjumlahkan_penyebut") {
              friendlyMsg = "Hampir benar, Ninja Muda! Ingat, penyebut (angka di bawah) tidak ikut dijumlahkan. Mari samakan penyebutnya!";
            } else if (q.allSameDenom) {
              friendlyMsg = "Belum tepat, Ninja Muda! Penyebutnya sudah sama, coba hitung kembali jumlah pembilangnya dan sederhanakan.";
            }

            fbText.textContent = `${friendlyMsg} (Sisa nyawa: ${this.lives})`;
            fbBanner.classList.remove("hidden");
            this.showProgressiveHint();
          }
        }
      },

      /**
       * Menampilkan Halaman / Modal Pembahasan dengan Visual Batang Pecahan
       */
      openExplanationModal(isCorrect, earnedPoints, gotSpeedBonus) {
        this.state = "EXPLANATION";
        const q = this.currentQuestion;

        const banner = document.getElementById("exp-status-banner");
        const icon = document.getElementById("exp-status-icon");
        const title = document.getElementById("exp-status-title");
        const subtitle = document.getElementById("exp-status-subtitle");
        const pill = document.getElementById("exp-points-pill");

        if (isCorrect) {
          banner.className = "p-3.5 rounded-2xl bg-emerald-100 border-2 border-emerald-500 text-emerald-950 flex items-center justify-between gap-3";
          icon.textContent = "🎉";
          title.textContent = "Tepat Sekali, Ninja Muda!";
          subtitle.textContent = gotSpeedBonus
            ? "Jawaban benar + Bonus kecepatan menjawab!"
            : "Jawabanmu benar dan sudah dalam bentuk paling sederhana!";
          pill.className = "px-3 py-1 rounded-full bg-emerald-600 text-white font-display font-bold text-sm";
          pill.textContent = `+${earnedPoints} Poin`;
        } else {
          banner.className = "p-3.5 rounded-2xl bg-amber-100 border-2 border-amber-500 text-amber-950 flex items-center justify-between gap-3";
          icon.textContent = "📘";
          title.textContent = "Mari Pelajari Pembahasannya!";
          subtitle.textContent = this.lives > 0
            ? "Perhatikan langkah di bawah ini sebelum melanjutkan petualangan."
            : "Nyawamu telah habis, namun pelajari dulu cara menyelesaikannya ya!";
          pill.className = "px-3 py-1 rounded-full bg-amber-600 text-white font-display font-bold text-sm";
          pill.textContent = "Pembahasan";
        }

        // Ringkasan persamaan lengkap
        const partsHTML = q.operands.map(op => op.frac.toHTML(q.preferMixed));
        document.getElementById("exp-equation-summary").innerHTML =
          `${partsHTML.join(` <span class="text-red-600 mx-1">+</span> `)} <span class="text-slate-500 mx-1">=</span> <span class="px-3 py-1 rounded-xl bg-emerald-100 border-2 border-emerald-500 text-emerald-900">${q.answer.toHTML(q.preferMixed)}</span>`;

        // Render Visualisasi Batang Pecahan SVG
        document.getElementById("exp-visual-container").innerHTML = FractionVisualizer.renderSVG(q);

        // Render Langkah demi Langkah
        const stepsList = document.getElementById("exp-steps-list");
        stepsList.innerHTML = q.steps.map(st => `<li>${st}</li>`).join("");

        UI.openModal("modal-explanation");
      },

      /**
       * Melanjutkan petualangan setelah membaca pembahasan
       */
      continueAfterExplanation() {
        UI.closeModal("modal-explanation");

        // Jika nyawa sudah habis -> masuk ke halaman hasil (Game Over)
        if (this.lives <= 0) {
          this.finishLevel(false);
          return;
        }

        // Tandai rintangan selesai & luncurkan lompatan akrobatik ninja melewati rintangan!
        const obs = this.obstacles[this.activeObstacleIndex];
        if (obs) {
          obs.solved = true;
          this.spawnParticles(obs.x + obs.width / 2, this.groundY - 30, "#34d399", 22);
        }

        this.state = "PLAYING";
        this.ninja.isHeroJumping = true;
        this.ninja.grounded = false;
        this.ninja.vy = -740;
        AudioFX.playJump();
        UI.showToast(
          this.lastAnswerWasCorrect
            ? "⚔️ Jurus Lompatan Pecahan! Hebat!"
            : "💨 Bom Asap Ninja! Ayo hati-hati di rintangan berikutnya!"
        );
        this.updateHUD();
      },

      /**
       * Kontrol Jeda & Navigasi
       */
      pauseGame() {
        if (this.state !== "PLAYING") return;
        this.state = "PAUSED";
        UI.openModal("modal-pause");
      },

      resumeGame() {
        if (this.state !== "PAUSED") return;
        UI.closeModal("modal-pause");
        this.lastFrameTime = performance.now();
        this.state = "PLAYING";
      },

      restartLevelFromPause() {
        UI.closeModal("modal-pause");
        this.startLevel(this.currentLevel);
      },

      returnToMenu() {
        this.state = "MENU";
        if (this.rafId) cancelAnimationFrame(this.rafId);
        UI.closeModal("modal-pause");
        UI.closeModal("modal-explanation");
        document.getElementById("question-overlay").classList.add("hidden");
        UI.showScreen("screen-menu");
      },

      updateHUD() {
        document.getElementById("hud-player-name").textContent = this.playerName;
        document.getElementById("hud-level-badge").textContent = `Lv.${this.currentLevel}`;
        document.getElementById("hud-score").textContent = this.score;
        document.getElementById("hud-coins").textContent = this.coins;
        document.getElementById("hud-correct").textContent = this.correctCount;
        document.getElementById("hud-wrong").textContent = this.wrongCount;

        // Render Hati Nyawa
        const heartsStr = "❤️".repeat(this.lives) + "🖤".repeat(Math.max(0, this.maxLives - this.lives));
        document.getElementById("hud-hearts").textContent = heartsStr;

        // Akurasi Jawaban
        const totalAns = this.correctCount + this.wrongCount;
        const accuracy = totalAns === 0 ? 100 : Math.round((this.correctCount / totalAns) * 100);
        document.getElementById("hud-accuracy").textContent = `${accuracy}%`;

        // Progres Rintangan
        const solvedCount = this.obstacles.filter(o => o.solved).length;
        const pct = Math.round((solvedCount / 5) * 100);
        document.getElementById("hud-progress-bar").style.width = `${pct}%`;
        document.getElementById("hud-progress-text").textContent = `${solvedCount}/5 Rintangan`;
      },

      /**
       * ======================================================================
       * HALAMAN HASIL & PERHITUNGAN GELAR NINJA
       * ======================================================================
       */
      async finishLevel(isVictory) {
        this.state = "RESULT";
        if (this.rafId) cancelAnimationFrame(this.rafId);

        if (isVictory) {
          AudioFX.playVictory();
        } else {
          AudioFX.playWrong();
        }

        const totalAns = this.correctCount + this.wrongCount;
        const accuracy = totalAns === 0 ? 0 : Math.round((this.correctCount / totalAns) * 100);

        // Gelar Ninja dihitung murni dari akurasi pengerjaan soal (bukan koin)
        let rankTitle = "🥷 Ninja Pemula";
        let plainRank = "Ninja Pemula";
        if (accuracy >= 90) {
          rankTitle = "👑 Ninja Master Pecahan";
          plainRank = "Ninja Master Pecahan";
        } else if (accuracy >= 70) {
          rankTitle = "⚔️ Ninja Hebat";
          plainRank = "Ninja Hebat";
        } else if (accuracy >= 50) {
          rankTitle = "🌟 Ninja Terampil";
          plainRank = "Ninja Terampil";
        }

        if (isVictory) {
          this.saveLevelRank(this.currentLevel, plainRank);
        }

        // Format waktu bermain
        const mins = String(Math.floor(this.elapsedSeconds / 60)).padStart(2, "0");
        const secs = String(Math.floor(this.elapsedSeconds % 60)).padStart(2, "0");

        document.getElementById("res-hero-emoji").textContent = isVictory ? "🏆" : "💫";
        document.getElementById("res-title").textContent = isVictory
          ? `Level ${this.currentLevel} Berhasil Ditaklukkan!`
          : "Kesempatan Habis — Ayo Bangkit Lagi!";
        document.getElementById("res-subtitle").textContent = isVictory
          ? `Selamat ${this.playerName}! Kamu berhasil mencapai Kuil Finis Desa Ninja.`
          : `Jangan menyerah ${this.playerName}! Setiap latihan membuat kemampuan pecahamu makin tajam.`;

        document.getElementById("res-rank-title").textContent = rankTitle;
        document.getElementById("res-score").textContent = this.score;
        document.getElementById("res-coins").textContent = `🪙 ${this.coins}`;
        document.getElementById("res-accuracy").textContent = `${accuracy}%`;
        document.getElementById("res-correct").textContent = this.correctCount;
        document.getElementById("res-wrong").textContent = this.wrongCount;
        document.getElementById("res-time").textContent = `${mins}:${secs}`;

        const nextBtn = document.getElementById("btn-next-level");
        if (isVictory && this.currentLevel < 4) {
          nextBtn.classList.remove("hidden");
        } else {
          nextBtn.classList.add("hidden");
        }

        UI.showScreen("screen-result");

        // Dapatkan rekomendasi latihan dari AI Ninja Sensei / analisis lokal
        const recEl = document.getElementById("res-recommendation");
        const recBadge = document.getElementById("res-ai-badge");
        recEl.textContent = "🧙‍♂️ Ninja Sensei sedang menganalisis hasil latihanmu...";

        const recResult = await AISensei.getEndLevelRecommendation({
          level: this.currentLevel,
          correct: this.correctCount,
          wrong: this.wrongCount,
          accuracy,
          mistakes: this.mistakeTypes
        });

        recEl.textContent = recResult.text;
        recBadge.textContent = recResult.isAI ? "🤖 AI Ninja Sensei" : "📜 Evaluasi Sensei";
      },

      /**
       * ======================================================================
       * RENDER GRAFIK DUNIA DESA NINJA 2D DI CANVAS
       * ======================================================================
       */
      render() {
        const ctx = this.ctx;
        const W = this.logicalWidth;
        const H = this.logicalHeight;

        ctx.clearRect(0, 0, W, H);

        // 1. Langit Gradien Hangat
        const skyGrad = ctx.createLinearGradient(0, 0, 0, this.groundY);
        skyGrad.addColorStop(0, "#38bdf8");
        skyGrad.addColorStop(0.55, "#bae6fd");
        skyGrad.addColorStop(1, "#fef3c7");
        ctx.fillStyle = skyGrad;
        ctx.fillRect(0, 0, W, H);

        // Matahari Pagi Jepang
        ctx.fillStyle = "#fde047";
        ctx.beginPath();
        ctx.arc(W * 0.82, 82, 42, 0, Math.PI * 2);
        ctx.fill();

        // 2. Pegunungan Parallax (Gunung Fuji)
        const fujiX = 360 - (this.cameraX * 0.12) % 900;
        this.drawMountFuji(ctx, fujiX, this.groundY);
        this.drawMountFuji(ctx, fujiX + 900, this.groundY);

        // 3. Awan Bergerak
        ctx.fillStyle = "rgba(255, 255, 255, 0.88)";
        for (const c of this.clouds) {
          const sx = c.x - this.cameraX * 0.35;
          if (sx < -150 || sx > W + 150) continue;
          this.drawCloud(ctx, sx, c.y, c.scale);
        }

        // 4. Bukit Hijau & Pohon Sakura Latar Belakang
        ctx.fillStyle = "#4ade80";
        ctx.beginPath();
        ctx.moveTo(0, this.groundY);
        for (let x = 0; x <= W + 100; x += 100) {
          const worldHillX = x + this.cameraX * 0.45;
          const hillH = Math.sin(worldHillX * 0.004) * 38 + 48;
          ctx.lineTo(x, this.groundY - hillH);
        }
        ctx.lineTo(W, this.groundY);
        ctx.closePath();
        ctx.fill();

        // Pohon Sakura & Lentera Batu
        for (let tx = 180; tx < this.worldLength; tx += 460) {
          const sx = tx - this.cameraX * 0.75;
          if (sx < -120 || sx > W + 120) continue;
          this.drawSakuraTree(ctx, sx, this.groundY);
        }

        // 5. Tanah Utama & Rumput (dengan lubang jurang pada rintangan tipe chasm/river)
        this.drawTerrain(ctx, W, H);

        // 6. Platform Bambu Melayang
        for (const plat of this.platforms) {
          const sx = plat.x - this.cameraX;
          if (sx + plat.w < -20 || sx > W + 20) continue;
          this.drawBambooPlatform(ctx, sx, plat.y, plat.w, plat.h);
        }

        // 7. Rintangan (Jurang Bambu, Batu Segel, Sungai Koi, Gerbang Naga)
        for (const obs of this.obstacles) {
          const sx = obs.x - this.cameraX;
          if (sx + obs.width < -60 || sx > W + 60) continue;
          this.drawObstacle(ctx, sx, obs);
        }

        // 8. Kuil Garis Finis
        const finishScreenX = this.finishX - this.cameraX;
        if (finishScreenX < W + 200) {
          this.drawFinishDojo(ctx, finishScreenX, this.groundY);
        }

        // 9. Koin Emas
        const nowSec = performance.now() / 1000;
        for (const coin of this.coinItems) {
          if (coin.collected) continue;
          const sx = coin.x - this.cameraX;
          if (sx < -30 || sx > W + 30) continue;
          const bobY = coin.y + Math.sin(nowSec * 5 + coin.bobOffset) * 5;
          this.drawCoin(ctx, sx, bobY, coin.r, nowSec + coin.bobOffset);
        }

        // 10. Karakter Ninja Utama
        this.drawNinja(ctx, this.ninja.x - this.cameraX, this.ninja.y);

        // 11. Efek Partikel & Kelopak Sakura Terbang
        for (const pt of this.particles) {
          ctx.fillStyle = pt.color;
          ctx.beginPath();
          ctx.arc(pt.x - this.cameraX, pt.y, pt.size, 0, Math.PI * 2);
          ctx.fill();
        }

        ctx.fillStyle = "#f472b6";
        for (const p of this.sakuraPetals) {
          ctx.save();
          ctx.translate(p.x, p.y);
          ctx.rotate(p.rot);
          ctx.beginPath();
          ctx.ellipse(0, 0, p.size, p.size * 0.55, 0, 0, Math.PI * 2);
          ctx.fill();
          ctx.restore();
        }
      },

      drawMountFuji(ctx, centerX, baseY) {
        ctx.fillStyle = "#64748b";
        ctx.beginPath();
        ctx.moveTo(centerX - 240, baseY);
        ctx.lineTo(centerX - 38, baseY - 235);
        ctx.lineTo(centerX + 38, baseY - 235);
        ctx.lineTo(centerX + 240, baseY);
        ctx.closePath();
        ctx.fill();

        // Puncak Salju
        ctx.fillStyle = "#ffffff";
        ctx.beginPath();
        ctx.moveTo(centerX - 38, baseY - 235);
        ctx.lineTo(centerX + 38, baseY - 235);
        ctx.lineTo(centerX + 86, baseY - 172);
        ctx.lineTo(centerX + 42, baseY - 188);
        ctx.lineTo(centerX + 8, baseY - 165);
        ctx.lineTo(centerX - 32, baseY - 186);
        ctx.lineTo(centerX - 84, baseY - 170);
        ctx.closePath();
        ctx.fill();
      },

      drawCloud(ctx, x, y, scale) {
        ctx.save();
        ctx.translate(x, y);
        ctx.scale(scale, scale);
        ctx.beginPath();
        ctx.arc(0, 0, 24, 0, Math.PI * 2);
        ctx.arc(24, -6, 30, 0, Math.PI * 2);
        ctx.arc(54, 0, 22, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      },

      drawSakuraTree(ctx, x, baseY) {
        // Batang pohon
        ctx.fillStyle = "#78350f";
        ctx.fillRect(x - 8, baseY - 88, 16, 88);
        // Tajuk bunga sakura merah muda
        ctx.fillStyle = "#f9a8d4";
        ctx.beginPath();
        ctx.arc(x, baseY - 105, 42, 0, Math.PI * 2);
        ctx.arc(x - 30, baseY - 88, 30, 0, Math.PI * 2);
        ctx.arc(x + 30, baseY - 88, 30, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = "#f472b6";
        ctx.beginPath();
        ctx.arc(x - 10, baseY - 112, 22, 0, Math.PI * 2);
        ctx.arc(x + 18, baseY - 96, 20, 0, Math.PI * 2);
        ctx.fill();
      },

      drawTerrain(ctx, W, H) {
        // Tanah coklat penuh di bawah
        ctx.fillStyle = "#78350f";
        ctx.fillRect(0, this.groundY, W, H - this.groundY);

        // Lapisan rumput hijau di atas tanah
        ctx.fillStyle = "#16a34a";
        ctx.fillRect(0, this.groundY, W, 16);

        // Lubangi jurang / sungai pada rintangan chasm & river
        for (const obs of this.obstacles) {
          if (obs.type === "chasm" || obs.type === "river") {
            const sx = obs.x - this.cameraX;
            ctx.fillStyle = "#0f172a";
            ctx.fillRect(sx, this.groundY, obs.width, H - this.groundY);

            if (obs.type === "river") {
              // Air sungai biru
              ctx.fillStyle = "#0284c7";
              ctx.fillRect(sx, this.groundY + 26, obs.width, H - this.groundY);
              ctx.fillStyle = "#7dd3fc";
              ctx.fillRect(sx + 10, this.groundY + 34, obs.width - 20, 5);
            } else {
              // Bambu runcing di dasar jurang
              ctx.fillStyle = "#65a30d";
              for (let bx = sx + 12; bx < sx + obs.width - 10; bx += 22) {
                ctx.beginPath();
                ctx.moveTo(bx, H);
                ctx.lineTo(bx + 8, this.groundY + 46);
                ctx.lineTo(bx + 16, H);
                ctx.closePath();
                ctx.fill();
              }
            }

            // Jika rintangan sudah terjawab, munculkan jembatan bambu bercahaya!
            if (obs.solved) {
              this.drawBambooPlatform(ctx, sx - 6, this.groundY - 2, obs.width + 12, 14);
            }
          }
        }
      },

      drawBambooPlatform(ctx, x, y, w, h) {
        ctx.fillStyle = "#15803d";
        ctx.beginPath();
        ctx.roundRect(x, y, w, h, 7);
        ctx.fill();

        ctx.strokeStyle = "#bbf7d0";
        ctx.lineWidth = 2;
        ctx.stroke();

        // Ruas bambu
        ctx.fillStyle = "#14532d";
        for (let rx = x + 28; rx < x + w - 12; rx += 32) {
          ctx.fillRect(rx, y, 3, h);
        }
      },

      drawObstacle(ctx, sx, obs) {
        if (obs.type === "boulder" && !obs.solved) {
          // Batu raksasa dengan segel gulungan merah
          ctx.fillStyle = "#475569";
          ctx.beginPath();
          ctx.arc(sx + obs.width / 2, this.groundY - 36, 44, 0, Math.PI * 2);
          ctx.fill();
          ctx.strokeStyle = "#1e293b";
          ctx.lineWidth = 3;
          ctx.stroke();

          // Segel kertas kuning
          ctx.fillStyle = "#fef08a";
          ctx.fillRect(sx + obs.width / 2 - 14, this.groundY - 56, 28, 40);
          ctx.strokeStyle = "#dc2626";
          ctx.strokeRect(sx + obs.width / 2 - 14, this.groundY - 56, 28, 40);
          ctx.fillStyle = "#dc2626";
          ctx.font = "bold 16px Fredoka, sans-serif";
          ctx.textAlign = "center";
          ctx.fillText("?", sx + obs.width / 2, this.groundY - 30);
        } else if (obs.type === "gate" && !obs.solved) {
          // Gerbang Torii Segel Merah
          ctx.fillStyle = "#dc2626";
          ctx.fillRect(sx + 24, this.groundY - 110, 12, 110);
          ctx.fillRect(sx + obs.width - 36, this.groundY - 110, 12, 110);
          ctx.fillRect(sx + 10, this.groundY - 114, obs.width - 20, 14);
          ctx.fillRect(sx + 18, this.groundY - 90, obs.width - 36, 10);

          // Penghalang energi pecahan
          ctx.fillStyle = "rgba(251, 191, 36, 0.35)";
          ctx.fillRect(sx + 36, this.groundY - 80, obs.width - 72, 80);
        }

        // Papan tanda nomor rintangan
        ctx.fillStyle = obs.solved ? "#16a34a" : "#b45309";
        ctx.fillRect(sx - 24, this.groundY - 34, 4, 34);
        ctx.beginPath();
        ctx.roundRect(sx - 36, this.groundY - 52, 28, 20, 5);
        ctx.fill();
        ctx.fillStyle = "#ffffff";
        ctx.font = "bold 11px Nunito, sans-serif";
        ctx.textAlign = "center";
        ctx.fillText(obs.solved ? "✔" : `#${obs.index + 1}`, sx - 22, this.groundY - 38);
      },

      drawFinishDojo(ctx, sx, baseY) {
        // Bangunan Kuil Dojo Ninja Finis
        ctx.fillStyle = "#fef3c7";
        ctx.fillRect(sx + 20, baseY - 120, 140, 120);
        ctx.strokeStyle = "#92400e";
        ctx.lineWidth = 3;
        ctx.strokeRect(sx + 20, baseY - 120, 140, 120);

        // Pintu Dojo
        ctx.fillStyle = "#78350f";
        ctx.fillRect(sx + 68, baseY - 68, 44, 68);

        // Atap Pagoda Merah Bertingkat
        ctx.fillStyle = "#dc2626";
        ctx.beginPath();
        ctx.moveTo(sx, baseY - 118);
        ctx.lineTo(sx + 90, baseY - 165);
        ctx.lineTo(sx + 180, baseY - 118);
        ctx.closePath();
        ctx.fill();

        ctx.beginPath();
        ctx.moveTo(sx + 24, baseY - 155);
        ctx.lineTo(sx + 90, baseY - 192);
        ctx.lineTo(sx + 156, baseY - 155);
        ctx.closePath();
        ctx.fill();

        // Spanduk FINIS
        ctx.fillStyle = "#f59e0b";
        ctx.beginPath();
        ctx.roundRect(sx + 48, baseY - 108, 84, 24, 6);
        ctx.fill();
        ctx.fillStyle = "#1e293b";
        ctx.font = "bold 13px Fredoka, sans-serif";
        ctx.textAlign = "center";
        ctx.fillText("🏁 FINIS", sx + 90, baseY - 91);
      },

      drawCoin(ctx, x, y, r, phase) {
        const scaleX = Math.max(0.35, Math.abs(Math.cos(phase * 2.5)));
        ctx.save();
        ctx.translate(x, y);
        ctx.scale(scaleX, 1);

        ctx.fillStyle = "#f59e0b";
        ctx.beginPath();
        ctx.arc(0, 0, r, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = "#fde047";
        ctx.beginPath();
        ctx.arc(0, 0, r * 0.72, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = "#b45309";
        ctx.fillRect(-3, -3, 6, 6);
        ctx.restore();
      },

      drawNinja(ctx, sx, sy) {
        const n = this.ninja;
        ctx.save();
        ctx.translate(sx + n.w / 2, sy - n.h / 2);

        if (n.hurtTimer > 0) {
          ctx.translate(Math.sin(n.hurtTimer * 45) * 4, 0);
        }

        if (n.isHeroJumping) {
          ctx.rotate(n.flipAngle);
        }

        ctx.scale(n.facing, 1);

        // Kaki animasi lari
        const legSwing = n.grounded ? Math.sin(n.runCycle) * 8 : 6;
        ctx.fillStyle = "#0f172a";
        ctx.beginPath();
        ctx.roundRect(-11 + legSwing, 12, 8, 15, 4);
        ctx.roundRect(3 - legSwing, 12, 8, 15, 4);
        ctx.fill();

        // Badan Ninja
        ctx.fillStyle = "#1e293b";
        ctx.beginPath();
        ctx.roundRect(-14, -4, 28, 22, 8);
        ctx.fill();

        // Sabuk Merah
        ctx.fillStyle = "#dc2626";
        ctx.fillRect(-14, 8, 28, 5);

        // Ujung Ikat Kepala Berkibar di Belakang
        const tailWave = Math.sin(performance.now() / 110) * 4;
        ctx.fillStyle = "#dc2626";
        ctx.beginPath();
        ctx.moveTo(-14, -18);
        ctx.lineTo(-28, -22 + tailWave);
        ctx.lineTo(-25, -13 + tailWave);
        ctx.closePath();
        ctx.fill();

        // Kepala Ninja
        ctx.fillStyle = "#1e293b";
        ctx.beginPath();
        ctx.arc(0, -16, 17, 0, Math.PI * 2);
        ctx.fill();

        // Wajah
        ctx.fillStyle = "#fed7aa";
        ctx.beginPath();
        ctx.roundRect(-11, -21, 24, 10, 5);
        ctx.fill();

        // Ikat Kepala Merah
        ctx.fillStyle = "#dc2626";
        ctx.fillRect(-17, -26, 34, 6);

        // Mata
        ctx.fillStyle = "#0f172a";
        ctx.beginPath();
        ctx.arc(-2, -16, 2.3, 0, Math.PI * 2);
        ctx.arc(8, -16, 2.3, 0, Math.PI * 2);
        ctx.fill();

        ctx.restore();
      }
    };

    // Inisialisasi aplikasi setelah seluruh DOM siap
    window.addEventListener("DOMContentLoaded", () => {
      Game.init();
    });
  </script>
