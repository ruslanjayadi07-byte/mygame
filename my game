<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>NINJA FRACTION JUMP: Petualangan Penjumlahan Pecahan</title>
  <!-- Tailwind CSS untuk tata letak responsif & utilitas UI -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts ramah anak & mudah dibaca -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@600;700;800&display=swap" rel="stylesheet" />

  <style>
    /* ==========================================================================
       GAYA KUSTOM TEMA DESA NINJA JEPANG & KOMPONEN PECAHAN
       ========================================================================== */
    :root {
      --ninja-red: #dc2626;
      --ninja-gold: #f59e0b;
      --ninja-ink: #1e293b;
      --scroll-bg: #fffbeb;
      --scroll-border: #b45309;
      --bamboo-green: #15803d;
    }

    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
    }

    input, textarea, select {
      user-select: text;
    }

    body {
      font-family: 'Nunito', sans-serif;
      background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%);
      color: #1e293b;
      margin: 0;
      padding: 0;
      overflow-x: hidden;
      min-height: 100vh;
    }

    h1, h2, h3, .font-display {
      font-family: 'Fredoka', sans-serif;
    }

    /* Tampilan Pecahan Bertumpuk (Pembilang di atas Penyebut) */
    .frac-inline {
      display: inline-flex;
      align-items: center;
      vertical-align: middle;
      gap: 0.2em;
      font-weight: 800;
      line-height: 1;
      margin: 0 0.12em;
    }

    .frac-whole {
      font-size: 1.15em;
    }

    .frac-stack {
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-size: 0.88em;
      line-height: 1.05;
    }

    .frac-num {
      padding: 0 0.22em 0.08em;
      border-bottom: 2.5px solid currentColor;
      text-align: center;
      min-width: 1.1em;
    }

    .frac-den {
      padding: 0.08em 0.22em 0;
      text-align: center;
      min-width: 1.1em;
    }

    /* Tekstur Gulungan Perkamen Ninja */
    .ninja-scroll {
      background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
      border: 4px solid #b45309;
      box-shadow:
        0 12px 28px rgba(15, 23, 42, 0.35),
        inset 0 0 0 3px #fde68a;
      position: relative;
    }

    /* Tombol Bergaya Game Arcade 3D */
    .btn-ninja {
      transition: transform 0.12s ease, box-shadow 0.12s ease, filter 0.15s ease;
      box-shadow: 0 5px 0 rgba(15, 23, 42, 0.35);
    }

    .btn-ninja:hover:not(:disabled) {
      transform: translateY(-2px);
      filter: brightness(1.05);
    }

    .btn-ninja:active:not(:disabled) {
      transform: translateY(3px);
      box-shadow: 0 2px 0 rgba(15, 23, 42, 0.35);
    }

    .btn-ninja:disabled {
      opacity: 0.55;
      cursor: not-allowed;
    }

    /* Animasi Getar saat Jawaban Salah */
    @keyframes gentleShake {
      0%, 100% { transform: translateX(0); }
      20% { transform: translateX(-8px); }
      40% { transform: translateX(8px); }
      60% { transform: translateX(-6px); }
      80% { transform: translateX(6px); }
    }

    .animate-shake {
      animation: gentleShake 0.42s ease-in-out;
    }

    /* Animasi Melayang Halus untuk Maskot */
    @keyframes floatSlow {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-8px); }
    }

    .animate-float {
      animation: floatSlow 2.8s ease-in-out infinite;
    }

    /* Animasi Pop-In Modal */
    @keyframes popIn {
      0% { opacity: 0; transform: scale(0.92) translateY(10px); }
      100% { opacity: 1; transform: scale(1) translateY(0); }
    }

    .animate-pop {
      animation: popIn 0.25s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    /* Kanvas Game Responsif */
    #gameCanvas {
      display: block;
      width: 100%;
      height: 100%;
      touch-action: none;
    }

    /* Scrollbar Kustom untuk Panel Pembahasan & Chat AI */
    ::-webkit-scrollbar {
      width: 7px;
      height: 7px;
    }
    ::-webkit-scrollbar-track {
      background: rgba(254, 243, 199, 0.5);
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb {
      background: #d97706;
      border-radius: 9999px;
    }
  </style>
</head>
<body class="bg-slate-900 text-slate-800">

  <!-- ========================================================================
       A. HALAMAN PEMBUKA (MAIN MENU SCREEN)
       ======================================================================== -->
  <section id="screen-menu" class="min-h-screen w-full flex flex-col items-center justify-center p-3 sm:p-6 relative overflow-hidden bg-gradient-to-b from-sky-300 via-amber-100 to-emerald-200">
    <!-- Dekorasi Latar Belakang SVG Desa Ninja & Gunung Fuji -->
    <svg class="absolute inset-0 w-full h-full pointer-events-none opacity-45" viewBox="0 0 1200 700" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <circle cx="980" cy="130" r="65" fill="#fde047" />
      <polygon points="350,560 600,210 850,560" fill="#64748b" />
      <polygon points="535,301 600,210 665,301 635,288 600,312 568,286" fill="#ffffff" />
      <path d="M0,560 Q300,490 600,550 T1200,530 L1200,700 L0,700 Z" fill="#22c55e" />
      <path d="M0,600 Q400,560 800,610 T1200,590 L1200,700 L0,700 Z" fill="#15803d" />
    </svg>

    <!-- Kontainer Utama Menu -->
    <div class="relative z-10 w-full max-w-4xl ninja-scroll rounded-3xl p-5 sm:p-8 shadow-2xl">
      <!-- Baris Atas: Status AI & Kontrol Suara -->
      <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
        <div id="menu-ai-status-badge" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs sm:text-sm font-bold bg-amber-200/80 text-amber-900 border border-amber-400">
          <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
          <span>Mode Offline (Bank Soal Bawaan)</span>
        </div>

        <div class="flex items-center gap-2">
          <button type="button" onclick="AudioFX.toggleMute()" id="menu-sound-btn" class="px-3 py-1.5 rounded-full bg-white/90 hover:bg-white border-2 border-amber-600 text-amber-900 font-bold text-xs sm:text-sm flex items-center gap-1.5 shadow-sm" title="Aktif/Nonaktifkan Suara">
            <span id="menu-sound-icon">🔊</span>
            <span class="hidden sm:inline">Suara Aktif</span>
          </button>
          <button type="button" onclick="UI.openModal('modal-ai-settings')" class="px-3 py-1.5 rounded-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs sm:text-sm flex items-center gap-1.5 shadow-sm">
            <span>🤖</span>
            <span>Pengaturan AI</span>
          </button>
        </div>
      </div>

      <!-- Header Judul & Ilustrasi Karakter Ninja -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
        <!-- Kolom Ilustrasi Maskot Ninja -->
        <div class="md:col-span-4 flex flex-col items-center justify-center">
          <div class="w-36 h-36 sm:w-44 sm:h-44 rounded-full bg-gradient-to-tr from-amber-300 via-rose-200 to-sky-200 border-4 border-amber-600 shadow-lg flex items-center justify-center animate-float relative">
            <!-- Ilustrasi Vektor Ninja Lucu -->
            <svg viewBox="0 0 160 160" class="w-32 h-32 sm:w-40 sm:h-40" aria-label="Karakter Ninja Pecahan">
              <!-- Ujung Ikat Kepala Merah Berkibar -->
              <path d="M35,54 Q12,42 8,58 Q22,64 38,62 Z" fill="#dc2626" />
              <path d="M34,62 Q10,66 14,80 Q28,74 40,68 Z" fill="#b91c1c" />
              <!-- Badan Ninja -->
              <rect x="52" y="96" width="56" height="42" rx="18" fill="#1e293b" />
              <!-- Sabuk Merah -->
              <rect x="52" y="114" width="56" height="9" fill="#dc2626" />
              <!-- Pedang/Gulungan di Punggung -->
              <rect x="102" y="42" width="10" height="68" rx="4" transform="rotate(24 102 42)" fill="#92400e" />
              <rect x="108" y="34" width="12" height="10" rx="2" transform="rotate(24 108 34)" fill="#f59e0b" />
              <!-- Kepala Ninja -->
              <circle cx="80" cy="64" r="36" fill="#1e293b" />
              <!-- Area Wajah -->
              <rect x="52" y="53" width="56" height="22" rx="11" fill="#fed7aa" />
              <!-- Ikat Kepala Merah -->
              <rect x="43" y="43" width="74" height="13" rx="6" fill="#dc2626" />
              <rect x="70" y="42" width="20" height="15" rx="3" fill="#94a3b8" />
              <circle cx="80" cy="49.5" r="3" fill="#dc2626" />
              <!-- Mata Semangat -->
              <circle cx="66" cy="64" r="5" fill="#0f172a" />
              <circle cx="67.5" cy="62.5" r="1.8" fill="#ffffff" />
              <circle cx="94" cy="64" r="5" fill="#0f172a" />
              <circle cx="95.5" cy="62.5" r="1.8" fill="#ffffff" />
              <!-- Pipi Merona -->
              <ellipse cx="57" cy="69" rx="4" ry="2.2" fill="#fb7185" opacity="0.75" />
              <ellipse cx="103" cy="69" rx="4" ry="2.2" fill="#fb7185" opacity="0.75" />
              <!-- Tangan Memegang Gulungan Matematika -->
              <circle cx="48" cy="112" r="9" fill="#1e293b" />
              <circle cx="112" cy="112" r="9" fill="#1e293b" />
              <rect x="58" y="103" width="44" height="18" rx="5" fill="#fef3c7" stroke="#b45309" stroke-width="2.5" />
              <text x="80" y="116" text-anchor="middle" font-size="11" font-weight="bold" fill="#b45309">½ + ¼</text>
            </svg>
          </div>

          <!-- Kredit Pembuat Game (Sesuai Permintaan User) -->
          <div class="mt-3 px-4 py-2 rounded-2xl bg-white/95 border-2 border-amber-500 shadow-sm text-center">
            <p class="text-[11px] uppercase tracking-wider font-extrabold text-amber-700">Pengembang & Kreator</p>
            <p class="text-sm sm:text-base font-display font-bold text-slate-900">Santi Prafita Ratnaningsih</p>
          </div>
        </div>

        <!-- Kolom Judul, Input Nama, dan Pilihan Level -->
        <div class="md:col-span-8 flex flex-col">
          <div class="inline-block self-start px-3 py-1 rounded-full bg-red-600 text-white text-xs font-extrabold tracking-wide uppercase mb-2 shadow-sm">
            Matematika SD Kelas 5 – 6
          </div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-slate-900 leading-tight drop-shadow-sm">
            NINJA <span class="text-red-600">FRACTION</span> JUMP
          </h1>
          <p class="text-base sm:text-lg font-bold text-amber-900 mt-1">
            Petualangan Penjumlahan Pecahan di Desa Ninja!
          </p>
          <p class="text-xs sm:text-sm text-slate-700 mt-1.5 leading-relaxed">
            Bantu Ninja Muda berlari, mengumpulkan koin emas, dan melompati rintangan dengan memecahkan tantangan penjumlahan pecahan bersama <strong>AI Ninja Sensei</strong>!
          </p>

          <!-- Input Nama Pemain -->
          <div class="mt-4 bg-white/80 p-3 rounded-2xl border-2 border-amber-400 flex flex-col sm:flex-row sm:items-center gap-2">
            <label for="player-name-input" class="text-xs sm:text-sm font-extrabold text-amber-950 whitespace-nowrap">
              🥷 Nama Ninja Muda:
            </label>
            <input
              type="text"
              id="player-name-input"
              maxlength="20"
              placeholder="Masukkan namamu..."
              value="Ninja Muda"
              class="w-full px-3 py-1.5 rounded-xl border-2 border-amber-300 focus:border-red-500 focus:outline-none font-bold text-slate-800 bg-white"
            />
          </div>

          <!-- Pilihan Tingkat Kesulitan / Level -->
          <div class="mt-4">
            <p class="text-xs sm:text-sm font-extrabold text-amber-950 mb-2">Pilih Tingkat Tantangan:</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5" id="level-selector-grid">
              <!-- Level 1 -->
              <button type="button" onclick="Game.selectLevel(1)" data-level-btn="1" class="level-card text-left p-3 rounded-2xl border-3 border-red-600 bg-white shadow-sm transition-all flex items-start justify-between gap-2 ring-2 ring-red-400">
                <div>
                  <span class="inline-block px-2 py-0.5 rounded-md bg-emerald-100 text-emerald-800 text-[11px] font-extrabold">LEVEL 1</span>
                  <h3 class="font-display font-bold text-slate-900 text-sm sm:text-base mt-0.5">Penyebut Sama</h3>
                  <p class="text-xs text-slate-600">Contoh: 1/5 + 2/5, 3/8 + 1/8</p>
                </div>
                <span id="badge-level-1" class="text-xs font-bold text-amber-700 bg-amber-100 px-2 py-1 rounded-lg">Siap</span>
              </button>

              <!-- Level 2 -->
              <button type="button" onclick="Game.selectLevel(2)" data-level-btn="2" class="level-card text-left p-3 rounded-2xl border-2 border-amber-300 bg-white/90 hover:bg-white shadow-sm transition-all flex items-start justify-between gap-2">
                <div>
                  <span class="inline-block px-2 py-0.5 rounded-md bg-sky-100 text-sky-800 text-[11px] font-extrabold">LEVEL 2</span>
                  <h3 class="font-display font-bold text-slate-900 text-sm sm:text-base mt-0.5">Penyebut Berbeda</h3>
                  <p class="text-xs text-slate-600">Contoh: 1/2 + 1/4, 1/3 + 1/6</p>
                </div>
                <span id="badge-level-2" class="text-xs font-bold text-amber-700 bg-amber-100 px-2 py-1 rounded-lg">Siap</span>
              </button>

              <!-- Level 3 -->
              <button type="button" onclick="Game.selectLevel(3)" data-level-btn="3" class="level-card text-left p-3 rounded-2xl border-2 border-amber-300 bg-white/90 hover:bg-white shadow-sm transition-all flex items-start justify-between gap-2">
                <div>
                  <span class="inline-block px-2 py-0.5 rounded-md bg-purple-100 text-purple-800 text-[11px] font-extrabold">LEVEL 3</span>
                  <h3 class="font-display font-bold text-slate-900 text-sm sm:text-base mt-0.5">Pecahan Campuran</h3>
                  <p class="text-xs text-slate-600">Contoh: 1 1/2 + 1/2, 2 1/4 + 1 1/2</p>
                </div>
                <span id="badge-level-3" class="text-xs font-bold text-amber-700 bg-amber-100 px-2 py-1 rounded-lg">Siap</span>
              </button>

              <!-- Level 4 -->
              <button type="button" onclick="Game.selectLevel(4)" data-level-btn="4" class="level-card text-left p-3 rounded-2xl border-2 border-amber-300 bg-white/90 hover:bg-white shadow-sm transition-all flex items-start justify-between gap-2">
                <div>
                  <span class="inline-block px-2 py-0.5 rounded-md bg-rose-100 text-rose-800 text-[11px] font-extrabold">LEVEL 4</span>
                  <h3 class="font-display font-bold text-slate-900 text-sm sm:text-base mt-0.5">Tantangan Ninja Master</h3>
                  <p class="text-xs text-slate-600">3 Pecahan, Hasil &gt; 1 &amp; Soal Cerita</p>
                </div>
                <span id="badge-level-4" class="text-xs font-bold text-amber-700 bg-amber-100 px-2 py-1 rounded-lg">Siap</span>
              </button>
            </div>
          </div>

          <!-- Tombol Aksi Utama -->
          <div class="mt-5 flex flex-wrap items-center gap-3">
            <button type="button" onclick="Game.startLevel(Game.selectedLevel)" class="btn-ninja flex-1 min-w-[200px] py-3.5 px-6 rounded-2xl bg-gradient-to-r from-red-600 to-rose-600 text-white font-display font-bold text-lg sm:text-xl flex items-center justify-center gap-2 border-2 border-red-800">
              <span>⚔️</span>
              <span>Mulai Petualangan</span>
            </button>

            <button type="button" onclick="UI.openModal('modal-instructions')" class="btn-ninja py-3.5 px-4 rounded-2xl bg-amber-400 hover:bg-amber-300 text-amber-950 font-display font-bold text-sm sm:text-base flex items-center gap-1.5 border-2 border-amber-600">
              <span>📜</span>
              <span>Petunjuk</span>
            </button>

            <button type="button" onclick="UI.openSenseiChat()" class="btn-ninja py-3.5 px-4 rounded-2xl bg-emerald-600 hover:bg-emerald-500 text-white font-display font-bold text-sm sm:text-base flex items-center gap-1.5 border-2 border-emerald-800">
              <span>🧙‍♂️</span>
              <span>Tanya Sensei</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================
       B. HALAMAN PERMAINAN (GAMEPLAY SCREEN)
       ======================================================================== -->
  <section id="screen-game" class="hidden min-h-screen w-full flex flex-col bg-slate-900 overflow-hidden">
    <!-- Panel HUD Atas -->
    <header class="w-full bg-slate-900/95 text-white px-2.5 sm:px-5 py-2 border-b-2 border-amber-500/60 z-20 shrink-0">
      <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2">
        <!-- Info Pemain, Nyawa, Skor, Koin -->
        <div class="flex flex-wrap items-center gap-2 sm:gap-3">
          <div class="px-2.5 py-1 rounded-xl bg-slate-800 border border-slate-700 flex items-center gap-1.5">
            <span class="text-sm">🥷</span>
            <span id="hud-player-name" class="font-bold text-xs sm:text-sm text-amber-300 truncate max-w-[100px] sm:max-w-[140px]">Ninja Muda</span>
            <span class="text-[11px] px-1.5 py-0.5 rounded bg-red-600 font-extrabold" id="hud-level-badge">Lv.1</span>
          </div>

          <!-- Nyawa (3 Kesempatan) -->
          <div class="px-2.5 py-1 rounded-xl bg-slate-800 border border-slate-700 flex items-center gap-1" title="Nyawa Tersisa">
            <span id="hud-hearts" class="text-sm sm:text-base tracking-widest">❤️❤️❤️</span>
          </div>

          <!-- Skor -->
          <div class="px-2.5 py-1 rounded-xl bg-slate-800 border border-slate-700 flex items-center gap-1.5">
            <span class="text-xs text-slate-400 font-bold">SKOR:</span>
            <span id="hud-score" class="font-display font-bold text-sm sm:text-base text-emerald-400">0</span>
          </div>

          <!-- Koin Emas -->
          <div class="px-2.5 py-1 rounded-xl bg-slate-800 border border-slate-700 flex items-center gap-1">
            <span class="text-sm">🪙</span>
            <span id="hud-coins" class="font-display font-bold text-sm sm:text-base text-amber-400">0</span>
          </div>
        </div>

        <!-- Statistik Benar/Salah, Akurasi & Tombol Kontrol HUD -->
        <div class="flex items-center gap-2 sm:gap-3">
          <div class="hidden md:flex items-center gap-2 px-3 py-1 rounded-xl bg-slate-800 border border-slate-700 text-xs font-bold">
            <span class="text-emerald-400">✔ <span id="hud-correct">0</span></span>
            <span class="text-slate-500">|</span>
            <span class="text-rose-400">✘ <span id="hud-wrong">0</span></span>
            <span class="text-slate-500">|</span>
            <span class="text-sky-300">Akurasi: <span id="hud-accuracy">100%</span></span>
          </div>

          <!-- Toggle Auto-Lari -->
          <button type="button" id="hud-autorun-btn" onclick="Game.toggleAutoRun()" class="px-2.5 py-1.5 rounded-xl bg-emerald-700/80 hover:bg-emerald-600 text-white text-xs font-bold border border-emerald-400/50" title="Ninja otomatis berlari menuju rintangan berikutnya">
            🏃 Auto-Lari: ON
          </button>

          <!-- Tanya AI Ninja Sensei -->
          <button type="button" onclick="UI.openSenseiChat()" class="px-2.5 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold flex items-center gap-1 border border-indigo-400/50" title="Tanya AI Ninja Sensei">
            <span>🧙‍♂️</span>
            <span class="hidden sm:inline">Sensei</span>
          </button>

          <!-- Tombol Suara -->
          <button type="button" onclick="AudioFX.toggleMute()" id="hud-sound-btn" class="p-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-600 text-sm" title="Suara">
            🔊
          </button>

          <!-- Tombol Jeda (Pause) -->
          <button type="button" onclick="Game.pauseGame()" class="px-3 py-1.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold text-xs sm:text-sm flex items-center gap-1 shadow" title="Jeda Permainan (Esc)">
            <span>⏸️</span>
            <span class="hidden sm:inline">Jeda</span>
          </button>
        </div>
      </div>

      <!-- Bilah Progres Menuju Garis Finis -->
      <div class="max-w-7xl mx-auto mt-2 flex items-center gap-2">
        <span class="text-[11px] font-bold text-amber-300 whitespace-nowrap">🏁 Finis:</span>
        <div class="w-full h-2.5 bg-slate-700 rounded-full overflow-hidden border border-slate-600 relative">
          <div id="hud-progress-bar" class="h-full bg-gradient-to-r from-amber-400 via-orange-500 to-red-500 transition-all duration-300" style="width: 0%"></div>
        </div>
        <span id="hud-progress-text" class="text-[11px] font-extrabold text-slate-300 whitespace-nowrap">0/5 Rintangan</span>
      </div>
    </header>

    <!-- Area Arena Kanvas 2D + Panel Soal Mengambang -->
    <main class="relative flex-1 w-full flex flex-col justify-between overflow-hidden">
      <!-- Kanvas Dunia Platformer -->
      <div id="canvas-wrapper" class="relative flex-1 w-full min-h-[260px] sm:min-h-[360px]">
        <canvas id="gameCanvas"></canvas>

        <!-- Notifikasi Cepat Mengambang di Kanvas (Poin, Bonus, Pesan) -->
        <div id="canvas-toast" class="pointer-events-none hidden absolute top-4 left-1/2 -translate-x-1/2 z-20 px-4 py-2 rounded-full bg-slate-900/90 text-amber-300 border-2 border-amber-400 font-display font-bold text-sm sm:text-base shadow-lg">
          +15 Poin! Lompatan Super!
        </div>

        <!-- PANEL SOAL PENJUMLAHAN PECAHAN (Muncul saat mendekati rintangan) -->
        <div id="question-overlay" class="hidden absolute inset-0 z-30 bg-slate-950/45 backdrop-blur-[2px] flex items-center justify-center p-2.5 sm:p-4 overflow-y-auto">
