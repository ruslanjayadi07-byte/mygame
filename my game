    /**
     * ========================================================================
     * 5. VISUALISASI BATANG PECAHAN (SVG FRACTION BAR MODEL UNTUK PEMBAHASAN)
     * ========================================================================
     */
    const FractionVisualizer = {
      renderSVG(problem) {
        const { operands, kpk, allSameDenom, answer, preferMixed } = problem;
        const barWidth = 260;
        const barHeight = 26;
        const rows = [];

        // Baris tiap suku pecahan
        operands.forEach((op, idx) => {
          const frac = op.frac;
          const displayDen = Math.min(frac.den, 16);
          const displayNum = Math.min(frac.num, displayDen);
          rows.push({
            label: `${op.raw}`,
            den: displayDen,
            filled: displayNum,
            color: idx === 0 ? "#0284c7" : idx === 1 ? "#7c3aed" : "#d97706",
            note: frac.num > frac.den ? "(Pecahan > 1)" : ""
          });

          if (!allSameDenom && kpk <= 16 && frac.den !== kpk) {
            const mult = kpk / frac.den;
            rows.push({
              label: `= ${frac.num * mult}/${kpk}`,
              den: kpk,
              filled: Math.min(frac.num * mult, kpk),
              color: idx === 0 ? "#38bdf8" : idx === 1 ? "#a78bfa" : "#fbbf24",
              note: "(Senilai)"
            });
          }
        });

        // Baris hasil akhir
        const resDen = Math.min(answer.den, 16);
        const resFilled = answer.num >= answer.den ? resDen : answer.num;
        rows.push({
          label: `Hasil: ${answer.toPlainString(preferMixed)}`,
          den: resDen,
          filled: resFilled,
          color: "#16a34a",
          note: answer.num > answer.den ? "(Lebih dari 1 utuh)" : "(Paling sederhana)"
        });

        const totalHeight = rows.length * 42 + 12;
        let svgContent = `<svg viewBox="0 0 460 ${totalHeight}" class="w-full max-w-lg mx-auto" role="img" aria-label="Diagram Batang Pecahan">`;

        rows.forEach((row, rIdx) => {
          const y = rIdx * 42 + 8;
          // Label kiri
          svgContent += `<text x="6" y="${y + 18}" font-size="13" font-weight="800" fill="#1e293b">${row.label}</text>`;

          // Batang terpartisi
          const startX = 115;
          const segW = barWidth / row.den;
          for (let i = 0; i < row.den; i++) {
            const fill = i < row.filled ? row.color : "#f1f5f9";
            svgContent += `<rect x="${startX + i * segW}" y="${y}" width="${segW}" height="${barHeight}" fill="${fill}" stroke="#334155" stroke-width="1.5" />`;
          }

          // Catatan kanan
          if (row.note) {
            svgContent += `<text x="${startX + barWidth + 8}" y="${y + 17}" font-size="11" font-weight="700" fill="#475569">${row.note}</text>`;
          }
        });

        svgContent += `</svg>`;
        return svgContent;
      }
    };

