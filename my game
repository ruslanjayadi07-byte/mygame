  <!-- ========================================================================
       SKRIP LOGIKA MATEMATIKA PECAHAN, AUDIO, AI SENSEI, DAN GAME ENGINE
       ======================================================================== -->
  <script>
    "use strict";

    /**
     * ========================================================================
     * 1. MODUL ARITMATIKA PECAHAN EKSAK (INTEGER-BASED RATIONAL MATH)
     * Menghindari kesalahan pembulatan floating-point & memastikan semua pecahan
     * selalu tereduksi ke bentuk paling sederhana.
     * ========================================================================
     */
    class Fraction {
      constructor(num, den = 1) {
        if (!Number.isInteger(num) || !Number.isInteger(den) || den === 0) {
          throw new Error("Pembilang dan penyebut harus bilangan bulat dengan penyebut != 0");
        }
        if (den < 0) {
          num = -num;
          den = -den;
        }
        if (num === 0) {
          this.num = 0;
          this.den = 1;
        } else {
          const divisor = Fraction.gcd(Math.abs(num), Math.abs(den));
          this.num = num / divisor;
          this.den = den / divisor;
        }
      }

      static gcd(a, b) {
        a = Math.abs(Math.round(a));
        b = Math.abs(Math.round(b));
        while (b !== 0) {
          const t = b;
          b = a % b;
          a = t;
        }
        return a || 1;
      }

      static lcm(a, b) {
        if (a === 0 || b === 0) return 0;
        return Math.abs((a * b) / Fraction.gcd(a, b));
      }

      static lcmArray(arr) {
        return arr.reduce((acc, val) => Fraction.lcm(acc, val), 1);
      }

      static fromMixed(whole, num, den) {
        const sign = whole < 0 ? -1 : 1;
        const absWhole = Math.abs(whole);
        return new Fraction(sign * (absWhole * den + num), den);
      }

      /**
       * Mengurai string seperti "3/4", "1 1/2", atau "2" menjadi objek Fraction
       */
      static parse(str) {
        if (str instanceof Fraction) return new Fraction(str.num, str.den);
        const clean = String(str).trim().replace(/\s+/g, " ");
        if (!clean) return null;

        // Format pecahan campuran: "1 1/2"
        const mixedMatch = clean.match(/^(-?\d+)\s+(\d+)\/(\d+)$/);
        if (mixedMatch) {
          const w = parseInt(mixedMatch[1], 10);
          const n = parseInt(mixedMatch[2], 10);
          const d = parseInt(mixedMatch[3], 10);
          if (d === 0) return null;
          return Fraction.fromMixed(w, n, d);
        }

        // Format pecahan biasa: "3/4"
        const fracMatch = clean.match(/^(-?\d+)\/(\d+)$/);
        if (fracMatch) {
          const n = parseInt(fracMatch[1], 10);
          const d = parseInt(fracMatch[2], 10);
          if (d === 0) return null;
          return new Fraction(n, d);
        }

        // Format bilangan bulat: "2"
        const intMatch = clean.match(/^(-?\d+)$/);
        if (intMatch) {
          return new Fraction(parseInt(intMatch[1], 10), 1);
        }

        return null;
      }

      add(other) {
        const commonDen = Fraction.lcm(this.den, other.den);
        const newNum = this.num * (commonDen / this.den) + other.num * (commonDen / other.den);
        return new Fraction(newNum, commonDen);
      }

      equals(other) {
        return other instanceof Fraction && this.num === other.num && this.den === other.den;
      }

      toMixedParts() {
        const whole = Math.trunc(this.num / this.den);
        const rem = Math.abs(this.num % this.den);
        return { whole, num: rem, den: this.den };
      }

      toPlainString(preferMixed = true) {
        if (this.den === 1) return `${this.num}`;
        if (preferMixed && Math.abs(this.num) > this.den) {
          const { whole, num, den } = this.toMixedParts();
          return num === 0 ? `${whole}` : `${whole} ${num}/${den}`;
        }
        return `${this.num}/${this.den}`;
      }

      toHTML(preferMixed = true) {
        if (this.den === 1) {
          return `<span class="frac-inline"><span class="frac-whole">${this.num}</span></span>`;
        }
        if (preferMixed && Math.abs(this.num) > this.den) {
          const { whole, num, den } = this.toMixedParts();
          if (num === 0) {
            return `<span class="frac-inline"><span class="frac-whole">${whole}</span></span>`;
          }
          return `<span class="frac-inline"><span class="frac-whole">${whole}</span><span class="frac-stack"><span class="frac-num">${num}</span><span class="frac-den">${den}</span></span></span>`;
        }
        return `<span class="frac-inline"><span class="frac-stack"><span class="frac-num">${this.num}</span><span class="frac-den">${this.den}</span></span></span>`;
      }
    }

    /**
     * ========================================================================
     * 2. GENERATOR & BANK SOAL PENJUMLAHAN PECAHAN SD (LEVEL 1 - 4)
     * Menghasilkan soal tervalidasi, pilihan pengecoh masuk akal, petunjuk
     * bertahap, dan penjelasan langkah demi langkah.
     * ========================================================================
     */
    const QuestionEngine = {
      usedSignatures: new Set(),

      resetSession() {
        this.usedSignatures.clear();
      },

      /**
       * Membangun objek soal lengkap dari daftar suku pecahan (operands)
       * yang dijamin valid secara matematis.
       */
      buildValidatedProblem({ level, operandStrings, story = "", customHints = null, source = "Lokal" }) {
        const operands = operandStrings.map(s => ({
          raw: s,
          frac: Fraction.parse(s)
        }));

        if (operands.some(o => !o.frac)) {
          throw new Error("Format pecahan tidak valid dalam pembuatan soal.");
        }

        // Hitung jumlah eksak
        const answer = operands.reduce((acc, item) => acc.add(item.frac), new Fraction(0, 1));
        const preferMixed = level >= 3 || answer.num > answer.den;

        // Hitung KPK penyebut untuk langkah penyelesaian
        const denoms = operands.map(o => o.frac.den);
        const kpk = Fraction.lcmArray(denoms);
        const allSameDenom = denoms.every(d => d === denoms[0]);

        // Susun petunjuk bertahap
        const hints = customHints && customHints.length >= 2 ? customHints : this.generateHints(operands, kpk, allSameDenom, answer, preferMixed);

        // Susun penjelasan langkah demi langkah
        const steps = this.generateSteps(operands, kpk, allSameDenom, answer, preferMixed);

        // Hasilkan 4 pilihan jawaban unik yang masuk akal
        const options = this.generateDistractors(operands, answer, preferMixed);

        return {
          level,
          operands,
          answer,
          preferMixed,
          kpk,
          allSameDenom,
          story,
          hints,
          steps,
          options,
          source
        };
      },

      generateHints(operands, kpk, allSameDenom, answer, preferMixed) {
        if (allSameDenom) {
          return [
            `Penyebut semua pecahan sudah sama, yaitu ${kpk}. Kamu cukup menjumlahkan bagian pembilangnya saja!`,
            `Jumlahkan pembilang: ${operands.map(o => o.frac.num).join(" + ")} dengan penyebut tetap ${kpk}, lalu sederhanakan jika bisa.`
          ];
        }
        const eqList = operands.map(o => {
          const factor = kpk / o.frac.den;
          return `${o.raw} = ${o.frac.num * factor}/${kpk}`;
        }).join(", ");
        return [
          `Penyebutnya berbeda (${operands.map(o => o.frac.den).join(" dan ")}). Samakan penyebutnya ke KPK yaitu ${kpk}.`,
          `Ubah pecahan menjadi berpenyebut ${kpk}: ${eqList}. Setelah itu jumlahkan pembilangnya!`
        ];
      },

      generateSteps(operands, kpk, allSameDenom, answer, preferMixed) {
        const steps = [];
        const exprText = operands.map(o => o.raw).join(" + ");

        if (allSameDenom) {
          steps.push(`Perhatikan soal: ${exprText}. Semua pecahan sudah memiliki penyebut yang sama, yaitu ${kpk}.`);
          const rawSumNum = operands.reduce((sum, o) => sum + o.frac.num, 0);
          steps.push(`Jumlahkan pembilangnya: (${operands.map(o => o.frac.num).join(" + ")}) / ${kpk} = ${rawSumNum}/${kpk}.`);
          if (rawSumNum !== answer.num || kpk !== answer.den) {
            steps.push(`Sederhanakan pecahan ${rawSumNum}/${kpk} menjadi bentuk paling sederhana: ${answer.toPlainString(preferMixed)}.`);
          } else {
            steps.push(`Hasil akhirnya adalah ${answer.toPlainString(preferMixed)}.`);
          }
        } else {
          steps.push(`Penyebut pecahan berbeda (${operands.map(o => o.frac.den).join(", ")}). Cari KPK dari penyebut tersebut, yaitu ${kpk}.`);
          const convertedParts = operands.map(o => {
            const mult = kpk / o.frac.den;
            return `${o.raw} = (${o.frac.num}×${mult})/(${o.frac.den}×${mult}) = ${o.frac.num * mult}/${kpk}`;
          });
          steps.push(`Ubah setiap pecahan ke penyebut ${kpk}: ${convertedParts.join("; ")}.`);
          const rawSumNum = operands.reduce((sum, o) => sum + o.frac.num * (kpk / o.frac.den), 0);
          steps.push(`Jumlahkan pembilang yang sudah sama penyebutnya: (${operands.map(o => o.frac.num * (kpk / o.frac.den)).join(" + ")}) / ${kpk} = ${rawSumNum}/${kpk}.`);
          if (rawSumNum !== answer.num || kpk !== answer.den) {
            steps.push(`Sederhanakan ${rawSumNum}/${kpk} menjadi bentuk paling sederhana: ${answer.toPlainString(preferMixed)}.`);
          } else {
            steps.push(`Bentuk paling sederhana dari hasil penjumlahan adalah ${answer.toPlainString(preferMixed)}.`);
          }
        }
        return steps;
      },

      /**
       * Membuat 4 pilihan jawaban (1 benar + 3 pengecoh edukatif)
       */
      generateDistractors(operands, answer, preferMixed) {
        const candidates = [
          { frac: answer, isCorrect: true, misconception: null }
        ];

        const addCandidate = (frac, misconception) => {
          if (!frac || frac.num <= 0) return;
          if (!candidates.some(c => c.frac.equals(frac))) {
            candidates.push({ frac, isCorrect: false, misconception });
          }
        };

        // Pengecoh 1: Kesalahan umum siswa SD -> menjumlahkan penyebut secara langsung
        const sumNumRaw = operands.reduce((s, o) => s + o.frac.num, 0);
        const sumDenRaw = operands.reduce((s, o) => s + o.frac.den, 0);
        addCandidate(new Fraction(sumNumRaw, sumDenRaw), "menjumlahkan_penyebut");

        // Pengecoh 2: Menjumlahkan pembilang tanpa mengubah penyebut terbesar
        const maxDen = Math.max(...operands.map(o => o.frac.den));
        addCandidate(new Fraction(sumNumRaw, maxDen), "lupa_menyamakan_penyebut");

        // Pengecoh 3 & 4: Variasi pembilang +/- 1 atau +/- 2 pada penyebut jawaban
        const offsets = [1, -1, 2, -2, 3];
        for (const off of offsets) {
          if (candidates.length >= 4) break;
          if (answer.num + off > 0) {
            addCandidate(new Fraction(answer.num + off, answer.den), "hitung_pembilang");
          }
        }

        // Pengaman jika masih kurang dari 4 opsi unik
        let extraDen = answer.den + 1;
        while (candidates.length < 4) {
          addCandidate(new Fraction(answer.num, extraDen), "lainnya");
          extraDen++;
        }

        // Acak urutan pilihan (Fisher-Yates)
        const finalFour = candidates.slice(0, 4).map(c => ({
          frac: c.frac,
          labelPlain: c.frac.toPlainString(preferMixed),
          labelHTML: c.frac.toHTML(preferMixed),
          isCorrect: c.isCorrect,
          misconception: c.misconception
        }));

        for (let i = finalFour.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [finalFour[i], finalFour[j]] = [finalFour[j], finalFour[i]];
        }

        return finalFour;
      },

      /**
       * Bank soal kurasi & generator prosedural offline sesuai Level 1-4
       */
      getOfflineProblem(level) {
        const banks = {
          1: [
            { operands: ["1/5", "2/5"], story: "" },
            { operands: ["2/7", "3/7"], story: "" },
            { operands: ["3/8", "1/8"], story: "" },
            { operands: ["2/9", "4/9"], story: "" },
            { operands: ["3/10", "4/10"], story: "" },
            { operands: ["1/6", "4/6"], story: "" },
            { operands: ["5/12", "4/12"], story: "" },
            { operands: ["2/11", "6/11"], story: "" }
          ],
          2: [
            { operands: ["1/2", "1/4"], story: "" },
            { operands: ["1/3", "1/6"], story: "" },
            { operands: ["2/5", "1/10"], story: "" },
            { operands: ["1/2", "1/3"], story: "" },
            { operands: ["3/4", "1/8"], story: "" },
            { operands: ["2/3", "1/4"], story: "" },
            { operands: ["1/6", "1/2"], story: "" },
            { operands: ["3/10", "2/5"], story: "" }
          ],
          3: [
            { operands: ["1 1/2", "1/2"], story: "" },
            { operands: ["1 1/3", "2/3"], story: "" },
            { operands: ["2 1/4", "1 1/2"], story: "" },
            { operands: ["1 2/5", "1 1/5"], story: "" },
            { operands: ["2 1/6", "1 1/3"], story: "" },
            { operands: ["1 3/4", "1/2"], story: "" },
            { operands: ["2 1/3", "1 1/6"], story: "" },
            { operands: ["1 2/5", "1 3/10"], story: "" }
          ],
          4: [
            {
              operands: ["1/2", "1/4", "1/8"],
              story: "Latihan Tiga Gulungan: Gabungkan ketiga takaran ramuan energi ninja berikut!"
            },
            {
              operands: ["3/4", "2/3"],
              story: "Rina membawa 3/4 liter air minum dan Budi membawa 2/3 liter air minum untuk latihan di dojo. Berapa liter total air minum mereka?"
            },
            {
              operands: ["2 2/3", "1 1/4"],
              story: "Panjang bambu pertama 2 2/3 meter dan bambu kedua 1 1/4 meter. Berapa meter panjang gabungan kedua bambu tersebut?"
            },
            {
              operands: ["1/3", "1/6", "1/2"],
              story: "Akira berlari 1/3 km di pagi hari, 1/6 km di siang hari, dan 1/2 km di sore hari. Berapa km total jarak tempuh Akira?"
            },
            {
              operands: ["4/5", "1/2"],
              story: "Ibu membeli 4/5 kg tepung beras dan 1/2 kg gula merah untuk membuat mochi desa ninja. Berapa kg berat seluruh belanjaan Ibu?"
            },
            {
              operands: ["1 3/5", "2 1/2"],
              story: "Tantangan Master: Jumlahkan dua pecahan campuran berpenyebut berbeda berikut!"
            }
          ]
        };

        const pool = banks[level] || banks[1];
        // Cari soal yang belum dipakai pada sesi ini
        const unused = pool.filter(item => !this.usedSignatures.has(item.operands.join("+")));
        let chosen;
        if (unused.length > 0) {
          chosen = unused[Math.floor(Math.random() * unused.length)];
        } else {
          // Buat variasi prosedural dinamis jika bank kurasi sudah habis terpakai
          chosen = this.generateProceduralItem(level);
        }

        this.usedSignatures.add(chosen.operands.join("+"));
        return this.buildValidatedProblem({
          level,
          operandStrings: chosen.operands,
          story: chosen.story,
          source: "Gulungan Bawaan"
        });
      },

      generateProceduralItem(level) {
        if (level === 1) {
          const den = [5, 6, 7, 8, 9, 10, 12][Math.floor(Math.random() * 7)];
          const n1 = Math.floor(Math.random() * (den - 2)) + 1;
          const n2 = Math.floor(Math.random() * (den - n1)) + 1;
          return { operands: [`${n1}/${den}`, `${n2}/${den}`], story: "" };
        }
        if (level === 2) {
          const pairs = [[2, 4], [2, 6], [3, 6], [3, 9], [4, 8], [5, 10], [2, 3], [3, 4]];
          const [d1, d2] = pairs[Math.floor(Math.random() * pairs.length)];
          const n1 = Math.floor(Math.random() * (d1 - 1)) + 1;
          const n2 = Math.floor(Math.random() * (d2 - 1)) + 1;
          return { operands: [`${n1}/${d1}`, `${n2}/${d2}`], story: "" };
        }
        if (level === 3) {
          const w1 = Math.floor(Math.random() * 2) + 1;
          const w2 = Math.floor(Math.random() * 2) + 1;
          const pairs = [[2, 4], [3, 6], [4, 4], [5, 10]];
          const [d1, d2] = pairs[Math.floor(Math.random() * pairs.length)];
          return { operands: [`${w1} 1/${d1}`, `${w2} 1/${d2}`], story: "" };
        }
        return {
          operands: ["2/3", "3/4"],
          story: "Tantangan Cepat Ninja Master: Hitung jumlah kedua pecahan berikut!"
        };
      }
    };

    /**
     * ========================================================================
     * 3. MODUL EFEK SUARA SINTETIS (WEB AUDIO API - TANPA FILE EKSTERNAL)
     * ========================================================================
     */
    const AudioFX = {
      ctx: null,
      muted: false,
      volume: 0.7,

      init() {
        if (!this.ctx) {
          const AudioCtx = window.AudioContext || window.webkitAudioContext;
          if (AudioCtx) {
            this.ctx = new AudioCtx();
          }
        }
        if (this.ctx && this.ctx.state === "suspended") {
          this.ctx.resume().catch(() => {});
        }
      },

      setVolume(val) {
        this.volume = Math.max(0, Math.min(1, Number(val) / 100));
        this.updateButtons();
      },

      toggleMute() {
        this.init();
        this.muted = !this.muted;
        this.updateButtons();
      },

      updateButtons() {
        const icon = this.muted || this.volume === 0 ? "🔇" : "🔊";
        const menuIcon = document.getElementById("menu-sound-icon");
        const hudBtn = document.getElementById("hud-sound-btn");
        if (menuIcon) menuIcon.textContent = icon;
        if (hudBtn) hudBtn.textContent = icon;
      },

      playTone(freq, type = "sine", duration = 0.15, delay = 0, slideTo = null) {
        if (this.muted || this.volume <= 0) return;
        this.init();
        if (!this.ctx) return;

        try {
          const now = this.ctx.currentTime + delay;
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = type;
          osc.frequency.setValueAtTime(freq, now);
          if (slideTo) {
            osc.frequency.exponentialRampToValueAtTime(slideTo, now + duration);
          }

          gain.gain.setValueAtTime(0.001, now);
          gain.gain.linearRampToValueAtTime(0.22 * this.volume, now + 0.015);
          gain.gain.exponentialRampToValueAtTime(0.001, now + duration);

          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start(now);
          osc.stop(now + duration + 0.02);
        } catch (e) {
          // Abaikan jika browser membatasi autoplay audio
        }
